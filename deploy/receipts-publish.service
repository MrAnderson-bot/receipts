[Unit]
Description=Receipts: snapshot, build and publish the site
After=network-online.target
Wants=network-online.target
# A failed run is retried (below), but at most twice per scheduled run: three starts in two hours, then
# the unit waits for the next timer slot (they are at least three hours apart), so a lasting fault (an
# expired deploy token, say) costs two extra builds, not a build every twenty minutes all day.
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
User=receipts
WorkingDirectory=/opt/receipts
Environment=APP_DIR=/opt/receipts
# Root-only file; systemd reads it before dropping to the receipts user.
EnvironmentFile=/etc/receipts.env
ExecStart=/usr/bin/bash /opt/receipts/deploy/publish.sh
TimeoutStartSec=2h
# A run that exits non-zero (a build or deploy failure, not a single source failing) runs again
# twenty minutes later. A single source failing is recorded in the database and shown on /sources.
Restart=on-failure
RestartSec=20min
